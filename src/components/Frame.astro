---
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {}

const { class: className, ...attrs } = Astro.props;
---

<div
  class={cn(
    "my-4 overflow-hidden rounded-lg border border-border",
    className,
  )}
  {...attrs}
>
  <slot />
</div>
